func middle(xs: List[Int]) -> List[Int]
    example [1, 2, 3, 4] -> [2, 3]
    example [] -> []
    return xs[1:-1]
end func

func main() -> Unit with io
    let xs = [1, 2, 3, 4, 5]
    let s = "héllo wörld"
    print(xs[1:3])
    print(xs[:2])
    print(xs[3:])
    print(xs[:])
    print(xs[-2:])
    print(xs[3:99])
    print(xs[4:2])
    print(s[1:5])
    print(s[-5:])
    print(middle(xs))
    print(xs)
end func
