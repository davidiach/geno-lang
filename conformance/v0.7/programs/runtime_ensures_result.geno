// Proposal 0018: a failed `ensures` names the function, the call's argument
// values, the clause's source text and the result, rendered the way
// diagnostics render values (strings quoted) on every backend.

func shout(s: String) -> String
    ensures length(result) > 10
    example "hello world" -> "hello world!"
    return s + "!"
end func

func main() -> Unit
    print(shout("hello world"))
    print(shout("hi"))
    return ()
end func
