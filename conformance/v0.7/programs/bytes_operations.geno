func main() -> Unit with io
    let raw: Bytes = bytes_from_utf8("Hi!")
    print(raw.length())
    print(raw.to_hex())
    print(raw.to_base64())
    print(to_string(raw))
    let decoded = result_unwrap(bytes_from_base64(raw.to_base64()))
    print(decoded == raw)
    print(raw[0])
    print(raw[1:3].to_hex())
    print((bytes_from_utf8("A") + bytes_from_utf8("B")).to_hex())
    print(result_unwrap(bytes_from_hex("7f")) < result_unwrap(bytes_from_hex("80")))
end func
