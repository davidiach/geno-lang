func main() -> Unit with io
    let n = 42
    let big = 1234567
    let x = 3.14159
    let name = "héllo"
    print(f"[{n:5}] [{n:<5}] [{n:^5}] [{n:05d}] [{n:+d}] [{n:x}] [{n:b}]")
    print(f"[{big:,}] [{big:>12,}] [{-big:,}]")
    print(f"[{x:.2f}] [{x:8.3f}] [{x:+.0f}] [{x:.2e}] [{x:.1%}] [{n:.1f}]")
    print(f"[{2.5:.0f}] [{0.5:.0f}] [{1.5:.0f}] [{0.125:.2f}]")
    print(f"[{name:>8}] [{name:*^9}] [{name:.3}] [{[1, 2]:>8}] [{x:10}]")
    print(f"[{max(a: n, b: 7):4}] [{[1, 2, 3][1:]:>8}] [{n::>5}]")
end func
