# EXPECT: E502
# Deep recursion with match to test recursion limit. The call's result is
# used, so it is not a self tail call (proposal 0022) and each call nests.
func spin(n: Int) -> Int
    example 0 -> 0
    example 2 -> 2
    match n with
        | 0 -> return 0
        | _ -> return 1 + spin(n - 1)
    end match
end func

func main() -> Int
    return spin(1000)
end func
