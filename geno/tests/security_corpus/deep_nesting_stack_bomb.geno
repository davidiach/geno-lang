# EXPECT: E502
# Recursive function at depth 1000 (double the 500
# call-depth limit).  Verifies that the interpreter's
# call-depth tracker catches deep recursion before
# Python's own stack overflows.  The call's result is used,
# so it is not a self tail call (proposal 0022), which would
# not nest; tail_recursion_bomb.geno covers that case.
func descend(n: Int) -> Int
    example 0 -> 0
    if n <= 0 then
        return 0
    end if
    return 0 + descend(n - 1)
end func

func main() -> Int
    return descend(1000)
end func
