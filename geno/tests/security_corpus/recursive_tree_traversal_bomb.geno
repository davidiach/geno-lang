# EXPECT: E503
# Build a tree with structural sharing (O(n) memory) then
# traverse it recursively (O(2^n) time).  The tree is shallow,
# so the call-depth limit does not apply (`grow` ends in a self
# tail call, which does not nest; `count` nests 41 deep): the
# step limit stops the traversal.
type Tree = Leaf(x: Int) | Node(l: Tree, r: Tree)

func grow(t: Tree, d: Int) -> Tree
    example Leaf(0), 0 -> Leaf(0)
    if d <= 0 then
        return t
    end if
    return grow(Node(t, t), d - 1)
end func

func count(t: Tree) -> Int
    example Leaf(0) -> 1
    match t with
        | Leaf(x) -> return 1
        | Node(l, r) -> return 1 + count(l) + count(r)
    end match
end func

func main() -> Int
    let t: Tree = grow(Leaf(1), 40)
    return count(t)
end func
