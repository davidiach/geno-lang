# EXPECT: E503
# Use match guards with expensive recursive predicates
# to attempt resource exhaustion.  Each match guard
# triggers a long recursive call, multiplying work.  Both
# functions end in self tail calls, which do not nest
# (proposal 0022), so the step limit is what stops the
# quadratic work.
func expensive(n: Int) -> Bool
    example 0 -> true
    if n <= 0 then
        return true
    end if
    return expensive(n - 1)
end func

func attack(n: Int) -> Int
    example 0 -> 0
    if n <= 0 then
        return 0
    end if
    match n with
        | x when expensive(x) -> return attack(n - 1)
        | _ -> return 0
    end match
end func

func main() -> Int
    return attack(100000)
end func
